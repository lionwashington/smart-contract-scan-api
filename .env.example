# ============================================================
# Smart Contract Scan API — env template
# ============================================================

# ---- LLM backend (global default) ----
LLM_BASE_URL=https://your-proxy-url.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=claude-sonnet-4-6

# ---- Auth ----
# 生产必须 true。本地 dev 可以设 false 做裸跑测试。
# 默认 true（fail-safe，防止生产裸跑）。
AUTH_ENABLED=true

# 直连 Bearer token（你自己运维/监控用）。openssl rand -hex 32 生成。
# AUTH_ENABLED=true 且未配置 → 该通道关闭（只剩 RapidAPI 通道）。
API_KEY=

# RapidAPI 网关注入的 X-RapidAPI-Proxy-Secret 值。同一个值也要填进
# RapidAPI Provider Dashboard → API Settings → "Secret for your API"。
# AUTH_ENABLED=true 且未配置 → 该通道关闭（只剩直连通道）。
RAPIDAPI_PROXY_SECRET=

# ---- Tier-based 模型路由 ----
# RapidAPI X-RapidAPI-Subscription 映射：BASIC→free / PRO→starter / ULTRA→pro / MEGA→business
# 未配置的字段会 fallback 到 LLM_MODEL / LLM_BASE_URL / LLM_API_KEY。
# 典型搭法：free/starter 跑便宜快的（如 Fireworks DeepSeek），pro/business 跑 Claude Sonnet。
LLM_MODEL_FREE=
LLM_MODEL_STARTER=
LLM_MODEL_PRO=
LLM_MODEL_BUSINESS=

# 可选：per-tier base_url / api_key 覆盖（未配置则 fallback 全局）
LLM_BASE_URL_FREE=
LLM_BASE_URL_STARTER=
LLM_BASE_URL_PRO=
LLM_BASE_URL_BUSINESS=
LLM_API_KEY_FREE=
LLM_API_KEY_STARTER=
LLM_API_KEY_PRO=
LLM_API_KEY_BUSINESS=

# ---- 合约体积上限（bytes） ----
MAX_CONTRACT_SIZE=102400
