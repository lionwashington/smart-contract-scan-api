# ============================================================
# Smart Contract Scan API — env template
# ============================================================

# ---- LLM backend (global default) ----
LLM_BASE_URL=https://your-proxy-url.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=claude-sonnet-4-6

# ---- Auth ----
# 生产必须 true。本地 dev 可以设 false 做裸跑测试。
# 默认 true（fail-safe，防止生产裸跑）。
AUTH_ENABLED=true

# 直连 Bearer token（你自己运维/监控用）。openssl rand -hex 32 生成。
# AUTH_ENABLED=true 且未配置 → 该通道关闭（只剩 RapidAPI 通道）。
API_KEY=

# RapidAPI 网关注入的 X-RapidAPI-Proxy-Secret 值。同一个值也要填进
# RapidAPI Provider Dashboard → API Settings → "Secret for your API"。
# AUTH_ENABLED=true 且未配置 → 该通道关闭（只剩直连通道）。
RAPIDAPI_PROXY_SECRET=

# ---- 合约体积上限（bytes） ----
MAX_CONTRACT_SIZE=102400
